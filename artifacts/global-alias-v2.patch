 import wow_keybind_sync as sync
+import wow_keybind_app as app
 
 
 class CleanupTests(unittest.TestCase):
+    def test_loader_numpad_clear_aliases_map_to_numpad5(self) -> None:
+        for label in ("NUMPADCLEAR", "NUMPADDCLE", "NUMPADCLE"):
+            with self.subTest(label=label):
+                self.assertEqual(sync.parse_keybind_label(label).scan_code, sync.SCAN_CODES["NUMPAD5"])
+
+    def test_global_action_aliases_keep_config_names(self) -> None:
+        names = {"Trinket 1", "Trinket02", "Health Stone", "Healing Potion"}
+
+        self.assertEqual(
+            app.global_action_names(names),
+            {"Trinket 1", "Trinket02", "Health Stone", "Healing Potion"},
+        )
+        self.assertEqual(app.canonical_global_action_name("Trinket02"), "Trinket2")
+
