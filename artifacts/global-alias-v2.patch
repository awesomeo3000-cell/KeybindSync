+def canonical_global_action_name(name: str) -> str | None:
+    """Return the app's global-action name for common loader spellings."""
+    token = re.sub(r"[^a-z0-9]+", "", str(name).lower())
+    aliases = {
+        "trinket01": "Trinket1",
+        "trinketone": "Trinket1",
+        "trinket02": "Trinket2",
+        "trinkettwo": "Trinket2",
+    }
+    if token in aliases:
+        return aliases[token]
+    for action in GLOBAL_ACTIONS:
+        if re.sub(r"[^a-z0-9]+", "", action.lower()) == token:
+            return action
+    return None
+
+
+def global_action_names(names: set[str] | list[str]) -> set[str]:
+    """Keep original Config.ini spellings for matched global actions."""
+    return {name for name in names if canonical_global_action_name(name) in GLOBAL_ACTIONS}
+
 
