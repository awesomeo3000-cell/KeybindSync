+def read_num_lock_state() -> bool | None:
+    """Read the Windows NumLock toggle; return None when the state is unavailable."""
+    if os.name != "nt":
+        return None
+    try:
+        return bool(ctypes.windll.user32.GetKeyState(0x90) & 1)
+    except (AttributeError, OSError):
+        return None
+
